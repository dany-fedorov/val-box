{
  "name": "val-box",
  "version": "0.1.1",
  "description": "Typed value presence and result metadata for modular features, quick evals, and programmable tooling.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p ./tsconfig.json",
    "build": "tsc -p ./tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/dany-fedorov/val-box.git"
  },
  "homepage": "https://dany-fedorov.github.io/val-box",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "typescript",
    "presence",
    "metadata",
    "provenance",
    "snapshot",
    "configuration",
    "agent"
  ],
  "author": "Dany Fedorov",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "1.4.1",
    "typescript": "5.9.3"
  }
}
